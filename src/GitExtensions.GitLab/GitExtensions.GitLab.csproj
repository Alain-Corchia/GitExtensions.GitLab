<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <VersionPrefix>2.0.0</VersionPrefix>
    <AssemblyName>GitExtensions.GitLab.MergeRequests</AssemblyName>
    <RootNamespace>GitExtensions.GitLab</RootNamespace>
    <!-- Git Extensions resolves plugin dependencies by FileDescription prefix: keep it distinct from the assembly name. -->
    <AssemblyTitle>GitLab plugin for Git Extensions</AssemblyTitle>
    <IsGitExtensionsPlugin>true</IsGitExtensionsPlugin>
    <!-- Git Extensions assemblies reference the WindowsDesktop WindowsBase, unused by the plugin. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GitExtensions.GitLab.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\IconGitlab.ico" LogicalName="GitExtensions.GitLab.IconGitlab.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Marks the package as a Git Extensions 7.x plugin for the Plugin Manager, and downloads Git Extensions when not installed. -->
    <PackageReference Include="GitExtensions.Extensibility" Version="7.0.0.135" PrivateAssets="all" />
  </ItemGroup>

  <!-- Git Extensions assemblies: provided by the host at runtime, never copied to the output. -->
  <ItemGroup>
    <Reference Include="GitCommands" HintPath="$(GitExtensionsPath)\GitCommands.dll" Private="false" />
    <Reference Include="GitExtensions.Extensibility" HintPath="$(GitExtensionsPath)\GitExtensions.Extensibility.dll" Private="false" />
    <Reference Include="GitExtUtils" HintPath="$(GitExtensionsPath)\GitExtUtils.dll" Private="false" />
    <Reference Include="GitUI" HintPath="$(GitExtensionsPath)\GitUI.dll" Private="false" />
    <Reference Include="GitUIPluginInterfaces" HintPath="$(GitExtensionsPath)\GitUIPluginInterfaces.dll" Private="false" />
    <Reference Include="ResourceManager" HintPath="$(GitExtensionsPath)\ResourceManager.dll" Private="false" />
    <Reference Include="Microsoft.VisualStudio.Threading" HintPath="$(GitExtensionsPath)\Microsoft.VisualStudio.Threading.dll" Private="false" />
    <Reference Include="Microsoft.VisualStudio.Validation" HintPath="$(GitExtensionsPath)\Microsoft.VisualStudio.Validation.dll" Private="false" />
    <Reference Include="System.ComponentModel.Composition" HintPath="$(GitExtensionsPath)\System.ComponentModel.Composition.dll" Private="false" />
  </ItemGroup>

  <!-- Pack as .nupkg for the Git Extensions Plugin Manager -->
  <PropertyGroup>
    <NuspecFile>$(MSBuildThisFileDirectory)$(MSBuildProjectName).nuspec</NuspecFile>
    <Authors>ahmet.urun, Alain Corchia</Authors>
    <Description>GitLab plugin for Git Extensions: create, review, comment, approve and merge GitLab merge requests.</Description>
    <PackageProjectUrl>https://github.com/Alain-Corchia/GitExtensions.GitLab</PackageProjectUrl>
    <PackageTags>GitExtensions</PackageTags>
    <!-- The Plugin Manager expects the plugin assembly directly in lib/ -->
    <NoWarn>$(NoWarn);NU5101</NoWarn>
  </PropertyGroup>
  <Target Name="SetPackageProperties" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <NuspecProperties>
        id=$(PackageId);
        version=$(PackageVersion);
        configuration=$(Configuration);
        tags=$(PackageTags.Replace(';',' '));
        projectUrl=$(PackageProjectUrl);
        author=$(Authors);
        description=$(Description);
        targetDir=$(TargetDir);
        repoRoot=$(MSBuildThisFileDirectory)..\..\;
      </NuspecProperties>
    </PropertyGroup>
  </Target>

</Project>
